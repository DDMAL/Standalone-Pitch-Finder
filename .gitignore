.DS_Store
__pycache__/
*.pyc
.pytest_cache/
*.pt
!experiments/*/checkpoints/*.pt
data/*

# staff_finding_rerun/ keeps only the flattened, reusable outputs
# (detected_stafflines/ JSON, detected_stafflines_viz/ PNGs); the raw
# per-page pipeline dirs (YOLO txt + nested intermediate output) are
# regeneratable from the same command and not worth tracking.
staff_finding_rerun/*/
!staff_finding_rerun/detected_stafflines/
!staff_finding_rerun/detected_stafflines_viz/

# experiments/v2-square: every rendered figure is drawn on page images from
# DDMAL's private HF dataset (and the manual-check page embeds crops of them),
# and dataset/notes.csv (74 MB) is regenerated by dataset/build_dataset.py
experiments/v2-square/**/*.png
experiments/v2-square/**/*.jpg
!experiments/v2-square/figures/readme/*.png
experiments/v2-square/mei_groundtruth_check/einsiedeln/manual_check/manual_check.html
experiments/v2-square/dataset/notes.csv

# experiments/v3-multinote: same rule for figures; per-note predictions
# are regenerated by eval_notes.py
experiments/v3-multinote/**/*.png
experiments/v3-multinote/**/*.jpg
!experiments/v3-multinote/figures/readme/*.png
experiments/v3-multinote/results/*.npz
